# The launcher's tabs on a made-up console, for ./build.sh shot
[ARCHIVE]
NAME=Game Boy (Color)
TAB=GB/GBC
ENTRY_DIRECTORIES=/home/player/roms/gb;/home/player/roms/gbc
ENTRY_EXTENSIONS=gb;gbc;zip
COMMAND=retroarch -L /usr/lib/libretro/gambatte_libretro.so %s

[ARCHIVE]
NAME=Game Boy Advance
TAB=GBA
ENTRY_DIRECTORIES=/home/player/roms/gba
ENTRY_EXTENSIONS=gba;zip
COMMAND=retroarch -L /usr/lib/libretro/mgba_libretro.so %s

[ARCHIVE]
NAME=Nintendo
TAB=NES
ENTRY_DIRECTORIES=/home/player/roms/nes
ENTRY_EXTENSIONS=nes;zip
COMMAND=retroarch -L /usr/lib/libretro/fceumm_libretro.so %s

[ARCHIVE]
NAME=Super Nintendo
TAB=SNES
ENTRY_DIRECTORIES=/home/player/roms/snes
ENTRY_EXTENSIONS=sfc;smc;zip
COMMAND=retroarch -L /usr/lib/libretro/snes9x2005_libretro.so %s

[ARCHIVE]
NAME=Mega Drive
TAB=MD
ENTRY_DIRECTORIES=/home/player/roms/megadrive
ENTRY_EXTENSIONS=md;bin;zip
COMMAND=retroarch -L /usr/lib/libretro/picodrive_libretro.so %s
